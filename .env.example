# ACLClouds Bot configuration / Configuration de ACLClouds Bot
#
# EN: Copy this file to ".env" and fill in the values. Never share or commit ".env".
#     Only secrets and startup options live here; everything else is configured
#     in Discord with slash commands (/setup, /config...) and saved per server.
# FR: Copie ce fichier en « .env » et remplis les valeurs. Ne partage jamais « .env »
#     et ne l'envoie jamais sur Git. Seuls les secrets et options de démarrage sont
#     ici ; tout le reste se règle dans Discord (/setup, /config...), par serveur.

# --- Required / Obligatoire -------------------------------------------------

# EN: Bot token from https://discord.com/developers/applications
#     (your application > "Bot" > "Reset Token").
# FR: Jeton du bot, sur https://discord.com/developers/applications
#     (ton application > « Bot » > « Reset Token »).
DISCORD_TOKEN=

# --- Optional / Facultatif --------------------------------------------------

# EN: A server (guild) ID. Slash commands are registered on that server only and
#     appear instantly. Leave empty to register them globally (every server the
#     bot is in; Discord can take up to an hour to show them).
# FR: ID d'un serveur. Les commandes slash y sont enregistrées uniquement et
#     apparaissent tout de suite. Laisse vide pour un enregistrement global (tous
#     les serveurs du bot ; Discord peut mettre jusqu'à une heure à les afficher).
GUILD_ID=

# EN: Language for console messages and for servers that never ran
#     "/config language". One of: fr, en, es, de, pt. Default: fr.
# FR: Langue de la console et des serveurs qui n'ont jamais utilisé
#     « /config language ». Au choix : fr, en, es, de, pt. Par défaut : fr.
DEFAULT_LANGUAGE=en

# EN: Comma-separated user IDs treated as bot owners on every server
#     (they bypass protections and can use owner-only commands).
# FR: IDs d'utilisateurs séparés par des virgules, considérés comme propriétaires
#     du bot sur tous les serveurs (ils passent les protections et ont accès aux
#     commandes réservées au propriétaire).
OWNER_IDS=

# EN: Console verbosity: debug, info, warn or error. Default: info.
# FR: Niveau de détail de la console : debug, info, warn ou error. Par défaut : info.
LOG_LEVEL=info

# EN: Folder where server settings are saved. Default: ./data
# FR: Dossier où les réglages des serveurs sont enregistrés. Par défaut : ./data
DATA_DIR=

# --- Web dashboard / Tableau de bord web ------------------------------------

# EN: Port the dashboard web server listens on (PORT or SERVER_PORT, set by most
#     hosting panels, are also accepted). Leave all empty to disable the dashboard.
# FR: Port d'écoute du tableau de bord web (PORT ou SERVER_PORT, fournis par la
#     plupart des hébergeurs, sont aussi acceptés). Laisse vide pour le désactiver.
DASHBOARD_PORT=

# EN: Public base URL of the dashboard, e.g. https://bot.example.com
#     (used in links and as the OAuth2 redirect: add <URL>/auth/callback in the
#     Developer Portal > OAuth2 > Redirects).
# FR: Adresse publique du tableau de bord, par ex. https://bot.example.com
#     (utilisée dans les liens et comme redirection OAuth2 : ajoute <URL>/auth/callback
#     dans le portail développeur > OAuth2 > Redirects).
DASHBOARD_URL=

# EN: Optional. OAuth2 client secret (Developer Portal > OAuth2) to log in to the
#     dashboard with Discord. Secret: never share it.
# FR: Facultatif. Secret client OAuth2 (portail développeur > OAuth2) pour se
#     connecter au tableau de bord avec Discord. Secret : ne le partage jamais.
DISCORD_CLIENT_SECRET=

# EN: Optional. Secret (16+ random characters) used to sign dashboard sessions.
#     If empty, one is generated and saved in data/global.json.
# FR: Facultatif. Secret (16 caractères aléatoires ou plus) qui signe les sessions
#     du tableau de bord. Si vide, il est généré et gardé dans data/global.json.
DASHBOARD_SECRET=

# --- Developers / Développeurs ----------------------------------------------

# EN: Set to 1 to load every module and build the commands without connecting
#     to Discord (same as "npm run dry-run").
# FR: Mets 1 pour charger tous les modules et construire les commandes sans se
#     connecter à Discord (comme « npm run dry-run »).
DRY_RUN=
